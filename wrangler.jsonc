{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "biztreck-solutions",
  "main": "custom-worker.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  // Cloudflare D1 — holds a migrated copy of the MongoDB 'biztreck' data
  // (JSON-document model; see docs/D1-MIGRATION.md). Bound as env.biztreck so
  // the data layer can be cut over from Mongo to D1. The app still reads/writes
  // MongoDB today; this binding is wired and ready, nothing uses it yet.
  "d1_databases": [
    {
      "binding": "biztreck",
      "database_name": "biztreck",
      "database_id": "31af1ed8-9a68-43bd-9d7b-2d15621d46ce"
    }
  ],
  "observability": { "enabled": true },
  // Vercel crons (vercel.json) were /api/cron/generate-blogs (30 0 * * *) and
  // /api/cron/leados-maintenance (0 2 * * *). They are left EMPTY here because
  // this account is already at the Workers Free limit of 5 cron triggers per
  // account. To re-enable: upgrade to Workers Paid, or free a slot and add the
  // schedules back below (custom-worker.ts already dispatches both), or trigger
  // the endpoints externally with `Authorization: Bearer ${CRON_SECRET}`.
  "triggers": {
    "crons": []
  }
  // No "routes" here on purpose: the biztreck.com custom domain is attached to
  // this Worker from the Cloudflare dashboard (Workers → Domains & Routes), not
  // via a wrangler route binding.
}
