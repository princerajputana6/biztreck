{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "biztreck-solutions",
  "main": "custom-worker.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  "observability": { "enabled": true },
  // Replaces the Vercel crons from vercel.json. NOTE: the Workers Free plan
  // allows at most 5 cron triggers per account across ALL Workers. The dave
  // sites already use some — if this pushes the account over the limit, drop a
  // cron here (or trigger it via a service binding) and run it elsewhere.
  "triggers": {
    "crons": ["30 0 * * *", "0 2 * * *"]
  }
  // No "routes" here on purpose: the biztrek.com zone is not in Cloudflare yet.
  // Attach the custom domain (biztrek.com / www) to this Worker from the
  // Cloudflare dashboard after the zone is added and nameservers are pointed.
}
