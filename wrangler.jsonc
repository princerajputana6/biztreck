{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "biztreck-solutions",
  "main": "custom-worker.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  "observability": { "enabled": true },
  // Vercel crons (vercel.json) were /api/cron/generate-blogs (30 0 * * *) and
  // /api/cron/leados-maintenance (0 2 * * *). They are left EMPTY here because
  // this account is already at the Workers Free limit of 5 cron triggers per
  // account. To re-enable: upgrade to Workers Paid, or free a slot and add the
  // schedules back below (custom-worker.ts already dispatches both), or trigger
  // the endpoints externally with `Authorization: Bearer ${CRON_SECRET}`.
  "triggers": {
    "crons": []
  }
  // No "routes" here on purpose: the biztrek.com zone is not in Cloudflare yet.
  // Attach the custom domain (biztrek.com / www) to this Worker from the
  // Cloudflare dashboard after the zone is added and nameservers are pointed.
}
